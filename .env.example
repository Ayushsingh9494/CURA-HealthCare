# ============================================================
# CURA — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to Git.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DB_NAME=cura
DB_USERNAME=cura
DB_PASSWORD=change_me_in_production
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/cura

# ── Spring Boot server ────────────────────────────────────────
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── File storage ──────────────────────────────────────────────
FILE_UPLOAD_DIR=./uploads

# ── JWT (set in Milestone 2) ──────────────────────────────────
# Must be a random string of at least 32 characters.
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_random_secret_min_32_chars
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_DAYS=7

# ── AI Provider (Gemini) ──────────────────────────────────────
# Leave empty to use the mock provider (AI_PROVIDER=mock)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Notification Provider ─────────────────────────────────────
# 'mock' logs notifications to console. 'email' requires SMTP config below.
NOTIFICATION_PROVIDER=mock

# ── SMTP (only needed if NOTIFICATION_PROVIDER=email) ─────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@cura.local
